rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can READ products (so your shop page works for visitors)
    // But only YOU can WRITE (add/update products) from your secret /admin page
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // We will tighten this with a password/login later
    }

  }
}